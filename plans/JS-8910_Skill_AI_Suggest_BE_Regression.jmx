<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert code ∈ 200" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">200</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
prev.setSuccessful(true) // đánh giá theo JSON code bên dưới, không theo HTTP status
def fail = { String m -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(m + ' | body=' + body.take(400)) }
