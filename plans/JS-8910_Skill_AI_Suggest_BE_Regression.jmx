<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Lấy 21 tên skill có sẵn trong dictionary" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def J = new groovy.json.JsonGenerator.Options().disableUnicodeEscaping().build()
def items = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())?.data ?: []
def names = items*.skill_name.unique()
vars.put('names21', J.toJson(names.take(21)))
vars.put('names21Count', String.valueOf(names.take(21).size()))</stringProp></JSR223PostProcessor>
