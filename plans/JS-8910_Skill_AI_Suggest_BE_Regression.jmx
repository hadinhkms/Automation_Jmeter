<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[BE-1] S106 - GET /skills/suggest có seeker_id + job_id hợp lệ → 200" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${skillHost}</stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">${skillBase}/skills/suggest?request_id=${reqId}&amp;title=K%E1%BA%BF%20to%C3%A1n&amp;source=js_portal&amp;session_id=${sessionId}&amp;limit=30&amp;seeker_id=${seekerId}&amp;job_id=1</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp></HTTPSamplerProxy>
<hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert code ∈ 200" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">200</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
prev.setSuccessful(true) // đánh giá theo JSON code bên dưới, không theo HTTP status
def fail = { String m -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(m + ' | body=' + body.take(400)) }
if (prev.getResponseCode() == '403' &amp;&amp; (Parameters ?: '').tokenize('|')[0].split(',')*.trim().contains('403')) return // WAF/nginx chặn = bị chặn hợp lệ
def j
try { j = new JsonSlurper().parseText(body) } catch (e) { fail('Response không phải JSON'); return }
def strict = (vars.get('strictSpec') ?: 'true') == 'true'
def ps = (Parameters ?: '').tokenize('|')
def allowed = ((strict || ps.size() &lt; 2) ? ps[0] : ps[1]).split(',')*.trim()
def code = String.valueOf(j.code)
if (!allowed.contains(code)) { fail(&quot;code=${code}, mong đợi ${allowed}&quot; + (strict &amp;&amp; ps.size() &gt; 1 ? ' [strictSpec]' : '')); return }
def d = j.data
if (j.msg != 'success' || prev.getResponseCode() != '200') { fail('Phải msg=success, HTTP 200'); return }
if (!j.containsKey('nlp_occupation_id')) { fail('Thiếu nlp_occupation_id ở top-level'); return }
if (!(d instanceof List)) { fail('data phải là mảng skill'); return }
for (it in d) { if (it.keySet() != (['skill_id', 'skill_name', 'skill_type'] as Set)) { fail('debug=0 item chỉ được có skill_id, skill_name, skill_type: ' + it.keySet()); return } }
// Trùng tên (vd. 2 id cùng tên &quot;Adobe Illustrator&quot;) do FE loại khi hiển thị chip (chốt 11/11/2026) → API chỉ kiểm không trùng id
def ids = d*.skill_id
if (ids.size() != ids.toSet().size()) { fail('Có skill trùng id'); return }
if (!(d.size() &lt;= 30)) { fail(&quot;size=&quot; + d.size() + &quot; không thoả &lt;= 30&quot;); return }
if (d.isEmpty() || j.nlp_occupation_id == null) { fail('Title hợp lệ phải map được nghề + có skill'); return }
</stringProp></JSR223Assertion>
