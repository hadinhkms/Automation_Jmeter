<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="JS-8910 - Skill AI Suggest BE Regression" enabled="true"><stringProp name="TestPlan.comments">JS-8910 [BE] Skill standardization V1.0 - AI suggested skill (story JS-8837, spec ISE-941). Đối chiếu doc Confluence &quot;Skill Service. API&quot; v19 + checklist JS-8837 (tên sampler có tag [BE-x] = item checklist tab 1). Mặc định QC: api.vl24hv2.qc.sieuviet-team.com (/mix/fe, /seeker/fe/api/v1) + Skill Service api-intl.vl24hv2.qc.sieuviet-team.com/skill_service. Override: -JapiHost -JmixBase -JseekerBase -Jtoken -JseekerId. -JstrictSpec=false: các case lệch spec (đánh dấu) chấp nhận hành vi hiện tại. -JrunProfileWrite=false: bỏ module ghi profile (TG2). TG2 tự lưu &amp; restore resume_skills. -JrunWafProbe=true: bật case XSS/SQL A13, S207-S208 (WAF có thể chặn IP vài phút). -JrunSkillWrite=false: bỏ nhóm W (add/PUT/DELETE) trên seeker test giả -JqaSeekerId (mặc định 2099999901, tự dọn data=[] ở tearDown).</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="apiHost" elementType="Argument"><stringProp name="Argument.name">apiHost</stringProp><stringProp name="Argument.value">${__P(apiHost,api.vl24hv2.qc.sieuviet-team.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="mixBase" elementType="Argument"><stringProp name="Argument.name">mixBase</stringProp><stringProp name="Argument.value">${__P(mixBase,/mix/fe)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="seekerBase" elementType="Argument"><stringProp name="Argument.name">seekerBase</stringProp><stringProp name="Argument.value">${__P(seekerBase,/seeker/fe/api/v1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="branch" elementType="Argument"><stringProp name="Argument.name">branch</stringProp><stringProp name="Argument.value">${__P(branch,vl24h.north)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="token" elementType="Argument"><stringProp name="Argument.name">token</stringProp><stringProp name="Argument.value">${__P(token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="seekerId" elementType="Argument"><stringProp name="Argument.name">seekerId</stringProp><stringProp name="Argument.value">${__P(seekerId,2004466193)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="titleEnc" elementType="Argument"><stringProp name="Argument.name">titleEnc</stringProp><stringProp name="Argument.value">${__P(titleEnc,K%E1%BA%BF%20to%C3%A1n)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="strictSpec" elementType="Argument"><stringProp name="Argument.name">strictSpec</stringProp><stringProp name="Argument.value">${__P(strictSpec,true)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="runProfileWrite" elementType="Argument"><stringProp name="Argument.name">runProfileWrite</stringProp><stringProp name="Argument.value">${__P(runProfileWrite,true)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="runWafProbe" elementType="Argument"><stringProp name="Argument.name">runWafProbe</stringProp><stringProp name="Argument.value">${__P(runWafProbe,false)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="skillHost" elementType="Argument"><stringProp name="Argument.name">skillHost</stringProp><stringProp name="Argument.value">${__P(skillHost,api-intl.vl24hv2.qc.sieuviet-team.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="skillBase" elementType="Argument"><stringProp name="Argument.name">skillBase</stringProp><stringProp name="Argument.value">${__P(skillBase,/skill_service)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="qaSeekerId" elementType="Argument"><stringProp name="Argument.name">qaSeekerId</stringProp><stringProp name="Argument.value">${__P(qaSeekerId,2099999901)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="runSkillWrite" elementType="Argument"><stringProp name="Argument.name">runSkillWrite</stringProp><stringProp name="Argument.value">${__P(runSkillWrite,true)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="sessionId" elementType="Argument"><stringProp name="Argument.name">sessionId</stringProp><stringProp name="Argument.value">${__UUID()}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="reqId" elementType="Argument"><stringProp name="Argument.name">reqId</stringProp><stringProp name="Argument.value">init</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="nlpId" elementType="Argument"><stringProp name="Argument.name">nlpId</stringProp><stringProp name="Argument.value">null</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="skillIds" elementType="Argument"><stringProp name="Argument.name">skillIds</stringProp><stringProp name="Argument.value">[2531037,13929,1162028]</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="selectedId" elementType="Argument"><stringProp name="Argument.name">selectedId</stringProp><stringProp name="Argument.value">2531037</stringProp><stringProp name="Argument.