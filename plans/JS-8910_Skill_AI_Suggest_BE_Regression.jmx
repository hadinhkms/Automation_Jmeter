<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Lưu resume_skills gốc để restore" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def J = new groovy.json.JsonGenerator.Options().disableUnicodeEscaping().build()
def d = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).data
def sk = d?.resume_skills
if (sk instanceof List) {
  vars.put('origSkills', J.toJson(sk))
  if (props.get('js8910_origSkills') == null) props.put('js8910_origSkills', J.toJson(sk))
  // skill thêm vào phải có sẵn trong dictionary để không tạo skill rác trên Skill Service mỗi lần chạy
  def low = sk*.toLowerCase()
  def qa = ['Báo cáo thuế', 'Excel Khá', 'Phần Mềm MISA', 'HTKK'].find { !low.contains(it.toLowerCase()) }
  vars.put('qaSkill', qa)
  vars.put('skillsPlusQa', J.toJson(sk + [qa]))
} else { log.error('Không đọc được resume_skills: ' + prev.getResponseDataAsString().take(300)) }</stringProp></JSR223PostProcessor>
<hashTree></hashTree>
</hashTree>
