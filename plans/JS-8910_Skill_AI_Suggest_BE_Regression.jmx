<hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[BE-1] A01 - GET suggest happy (title có dấu, source=profile, limit=5)" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">false</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"></collectionProp></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">${mixBase}/skill/ai-suggest?name=${titleEnc}&amp;source=profile&amp;seeker_id=${seekerId}&amp;limit=5&amp;session_id=${sessionId}&amp;request_id=${reqId}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp></HTTPSamplerProxy>
<hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert code ∈ 200" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">200</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
prev.setSuccessful(true) // đánh giá theo JSON code bên dưới, không theo HTTP status
def fail = { String m -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(m + ' | body=' + body.take(400)) }
if (prev.getResponseCode() == '403' &amp;&amp; (Parameters ?: '').tokenize('|')[0].split(',')*.trim().contains('403')) return // WAF/nginx chặn = bị chặn hợp lệ
def j
try { j = new JsonSlurper().parseText(body) } catch (e) { fail('Response không phải JSON'); return }
def strict = (vars.get('strictSpec') ?: 'true') == 'true'
def ps = (Parameters ?: '').tokenize('|')
def allowed = ((strict || ps.size() &lt; 2) ? ps[0] : ps[1]).split(',')*.trim()
def code = String.valueOf(j.code)
if (!allowed.contains(code)) { fail(&quot;code=${code}, mong đợi ${allowed}&quot; + (strict &amp;&amp; ps.size() &gt; 1 ? ' [strictSpec]' : '')); return }
def d = j.data

if (!(d instanceof Map)) { fail('data phải là object {nlp_occupation_id, items}'); return }
if (!d.containsKey('nlp_occupation_id')) { fail('Thiếu nlp_occupation_id'); return }
if (d.nlp_occupation_id != null &amp;&amp; !(d.nlp_occupation_id instanceof Number)) { fail('nlp_occupation_id phải là số hoặc null'); return }
def items = d.items
if (!(items instanceof List)) { fail('items phải là mảng'); return }
for (it in items) {
  if (!(it.id instanceof Number) || !(it.name instanceof String) || !it.name.trim() || !it.containsKey('skill_type')) { fail('Item sai cấu trúc: ' + it); return }
}
def ids = items*.id
if (ids.size() != ids.toSet().size()) { fail('items bị trùng id: ' + ids); return }
if (!(items.size() &lt;= 5)) { fail(&quot;items.size()=${items.size()} không thoả &lt;= 5&quot;); return }
if (items.isEmpty() || d.nlp_occupation_id == null) { fail('Title hợp lệ phải map được nghề + có gợi ý'); return }
vars.put('nlpRef', String.valueOf(d.nlp_occupation_id))
</stringProp></JSR223Assertion>
<hashTree></hashTree>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract nlp_occupation_id + skill ids cho impression/selected" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
try {
  def d = new JsonSlurper().parseText(prev.getResponseDataAsString()).data
  def ids = (d?.items ?: [])*.id.take(3)
  if (ids.isEmpty()) ids = [2531037, 13929, 1162028]
  vars.put('nlpId', d?.nlp_occupation_id == null ? 'null' : String.valueOf(d.nlp_occupation_id))
  vars.put('skillIds', '[' + ids.join(',') + ']')
  vars.put('selectedId', String.valueOf(ids[0]))
  vars.put('updatedIds', '[' + ids.drop(1).join(',') + ']')
} catch (e) { log.warn('Extract suggest lỗi: ' + e) }</stringProp></JSR223PostProcessor>
<hashTree></hashTree>
</hashTree>
