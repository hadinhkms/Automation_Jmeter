<hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert code ∈ 422" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">422</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
prev.setSuccessful(true) // đánh giá theo JSON code bên dưới, không theo HTTP status
def fail = { String m -&gt; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(m + ' | body=' + body.take(400)) }
if (prev.getResponseCode() == '403' &amp;&amp; (Parameters ?: '').tokenize('|')[0].split(',')*.trim().contains('403')) return // WAF/nginx chặn = bị chặn hợp lệ
def j
try { j = new JsonSlurper().parseText(body) } catch (e) { fail('Response không phải JSON'); return }
def strict = (vars.get('strictSpec') ?: 'true') == 'true'
def ps = (Parameters ?: '').tokenize('|')
def allowed = ((strict || ps.size() &lt; 2) ? ps[0] : ps[1]).split(',')*.trim()
def code = String.valueOf(j.code)
if (!allowed.contains(code)) { fail(&quot;code=${code}, mong đợi ${allowed}&quot; + (strict &amp;&amp; ps.size() &gt; 1 ? ' [strictSpec]' : '')); return }
def d = j.data
if (prev.getResponseCode() != '422' || j.msg != 'validation_error' || j.error_code != 'VALIDATION_ERROR') { fail('Envelope 422 phải: HTTP 422, msg=validation_error, error_code=VALIDATION_ERROR'); return }
if (j.containsKey('error_message')) { fail('Không được có field error_message'); return }
if (!(d instanceof List)) { fail('data phải là chi tiết lỗi FastAPI (mảng)'); return }
for (f in ['session_id']) { if (!d.any { e -&gt; e.loc?.contains(f) }) { fail('Thiếu lỗi cho field ' + f + ': ' + d*.loc); return } }
</stringProp></JSR223Assertion>
