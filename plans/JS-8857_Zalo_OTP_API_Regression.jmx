<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="JS-8857 - Zalo OTP BE API Regression" enabled="true"><stringProp name="TestPlan.comments">JS-8857 [JS][BE] Zalo OTP - API regression theo checklist (Flow 01-22). Chạy: jmeter -n -t &lt;file&gt; [-Jphone=...]. Lưu ý: TG chính gửi OTP thật tới ${phone} và chạy hết 5 lượt/ngày (Flow 14) - ~10 phút. Không chạy lại trong vòng 2 phút sau lần gửi OTP gần nhất. TG Manual/Race tắt mặc định.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="seekerHost" elementType="Argument"><stringProp name="Argument.name">seekerHost</stringProp><stringProp name="Argument.value">${__P(seekerHost,api.vl24hv2.qc.sieuviet-team.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="seekerBase" elementType="Argument"><stringProp name="Argument.name">seekerBase</stringProp><stringProp name="Argument.value">${__P(seekerBase,/seeker)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="systemHost" elementType="Argument"><stringProp name="Argument.name">systemHost</stringProp><stringProp name="Argument.value">${__P(systemHost,api.vl24hv2.qc.sieuviet-team.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="systemBase" elementType="Argument"><stringProp name="Argument.name">systemBase</stringProp><stringProp name="Argument.value">${__P(systemBase,/system)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="apiHost" elementType="Argument"><stringProp name="Argument.name">apiHost</stringProp><stringProp name="Argument.value">${__P(apiHost,api.vl24hv2.qc.sieuviet-team.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="apiBase" elementType="Argument"><stringProp name="Argument.name">apiBase</stringProp><stringProp name="Argument.value">${__P(apiBase,/seeker)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="branch" elementType="Argument"><stringProp name="Argument.name">branch</stringProp><stringProp name="Argument.value">${__P(branch,vl24h)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="apiVersion" elementType="Argument"><stringProp name="Argument.name">apiVersion</stringProp><stringProp name="Argument.value">1.1</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="guestToken" elementType="Argument"><stringProp name="Argument.name">guestToken</stringProp><stringProp name="Argument.value">eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJjaGFubmVsX2NvZGUiOiJ2bDI0aCIsInVzZXIiOm51bGx9.b_GBXepcnCjRzAc9I5OdamF0Mx2K1rEg9sZVYpNx_rU</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="phone" elementType="Argument"><stringProp name="Argument.name">phone</stringProp><stringProp name="Argument.value">${__P(phone,0971344520)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="phoneB" elementType="Argument"><stringProp name="Argument.name">phoneB</stringProp><stringProp name="Argument.value">${__P(phoneB,0989646691)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="phoneC" elementType="Argument"><stringProp name="Argument.name">phoneC</stringProp><stringProp name="Argument.value">${__P(phoneC,0963002862)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="otpDefault" elementType="Argument"><stringProp name="Argument.name">otpDefault</stringProp><stringProp name="Argument.value">${__P(otpDefault,1111)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="invalidPrefixPhone" elementType="Argument"><stringProp name="Argument.name">invalidPrefixPhone</stringProp><stringProp name="Argument.value">0123456789</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="fakeAllowedPhone" elementType="Argument"><stringProp name="Argument.name">fakeAllowedPhone</stringProp><stringProp name="Argument.value">0209876543</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="manual_req" elementType="Argument"><stringProp name="Argument.name">manual_req</stringProp><stringProp name="Argument.value">${__P(manual_req,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="autoReset" elementType="Argument"><stringProp name="Argument.name">autoReset</stringProp><stringProp name="Argument.value">${__P(autoReset,true)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></TestPlan><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager - Global" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-API-Version</stringProp><stringProp name="Header.value">${apiVersion}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-BRANCH</stringProp><stringProp name="Header.value">${branch}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${guestToken}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Correlation-ID</stringProp><stringProp name="Header.value">jm-js8857-${__UUID()}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="TG-00 [setUp] Reset quota OTP (xóa request_otp_history hôm nay cho SĐT test)" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp></SetupThreadGroup><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[setUp] Reset quota OTP QC DB" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// setUp: reset quota OTP trong ngày (xóa request_otp_history) cho các SĐT test, để chạy từ Dashboard
// cũng không dính REQUEST_LIMIT. Best-effort: lỗi (thiếu python/creds) -&gt; log &amp; tiếp tục, KHÔNG fail test.
try {
    if ((vars.get('autoReset') ?: 'true') != 'true') { SampleResult.setResponseData('autoReset=false -&gt; skip', 'UTF-8'); return }
    def root = new File(System.getProperty('user.dir'))
    def script = new File(root, 'otp-tools/reset-otp-quota.py')
    if (!script.exists()) { SampleResult.setResponseData('Khong tim thay ' + script, 'UTF-8'); return }
    def phones = [vars.get('phone'), vars.get('phoneB'), vars.get('phoneC')].findAll { it }.unique()
    // Bỏ env QC_DB_* cũ (Windows user scope) để script đọc đúng D:/_Account_DB/qc_db.env
    def envList = System.getenv().findAll { k, v -&gt; !k.startsWith('QC_DB_') }.collect { k, v -&gt; k + '=' + v }
    def out = new StringBuilder()
    phones.each { ph -&gt;
        try {
            def p = ['python', '-I', 'otp-tools/reset-otp-quota.py', ph, '--yes'].execute(envList, root)
            def so = new StringBuilder(); def se = new StringBuilder()
            p.waitForProcessOutput(so, se)
            out.append('[' + ph + '] exit=' + p.exitValue() + ' ' + so.toString().readLines().findAll { it.contains('Deleted') || it.contains('Rows') || it.contains('Error') }.join(' | ') + '\n')
        } catch (e) { out.append('[' + ph + '] exec error: ' + e.message + '\n') }
    }
    SampleResult.setResponseData(out.toString(), 'UTF-8')
} catch (e) {
    SampleResult.setResponseData('reset skipped: ' + e.message, 'UTF-8')
}
</stringProp></JSR223Sampler><hashTree/></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG-01 JS-8857 Zalo OTP - API Regression (sequential, gửi OTP thật)" enabled="true"><stringProp name="TestPlan.comments"></stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="[Setup] Init run &amp; anti-bot secret" enabled="true"><stringProp name="TestPlan.comments"></stringProp></GenericController><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[prep] Init device ids &amp; counters" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">vars.put('device_web', UUID.randomUUID().toString())
vars.put('device_app', UUID.randomUUID().toString())
vars.put('device_id', vars.get('device_web'))
vars.put('otp_valid_until', '0')
vars.put('succ_count', '0')
vars.put('loop_i', '0')
vars.put('daily_done', 'false')
SampleResult.setResponseData(("device_web=" + String.valueOf(vars.get('device_web')) + " device_app=" + String.valueOf(vars.get('device_app'))), 'UTF-8')
</stringProp></JSR223Sampler><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S00 - GET system config secret key (anti-bot)" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="code" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">code</stringProp><stringProp name="Argument.value">vl24h_seeker_secret_key_request_otp_phone</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${systemHost}</stringProp><stringProp name="HTTPSampler.port">443</stringProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">${systemBase}/fe/configuration/detail</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save vars" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">secret_key=data.value</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
// Parameters: "var=json.path,var2=json.path". Also tracks OTP validity window for the [wait] steps.
def json = null
try { json = new JsonSlurper().parseText(prev.getResponseDataAsString()) } catch (ignored) { return }
def get = { String k -&gt;
    def cur = json
    for (p in k.split('\\.')) { if (cur instanceof Map) { cur = cur[p] } else { return null } }
    cur
}
Parameters.split(',').each { pair -&gt;
    if (!pair.contains('=')) { return }
    def (k, path) = pair.split('=', 2)
    def v = get(path.trim())
    vars.put(k.trim(), v == null ? '' : v.toString())
}
def secs = get('data.seconds') ?: get('data.remaining_seconds')
if (secs != null) {
    long until = System.currentTimeMillis() + (secs as long) * 1000L
    long prevUntil = (vars.get('otp_valid_until') ?: '0') as long
    vars.put('otp_valid_until', String.valueOf(Math.max(until, prevUntil)))
}
</stringProp></JSR223PostProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">code=200;data.value~^.{8,}$</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
// Rule DSL (Parameters): rules joined by ";" (AND); a rule may hold alternatives joined by " || " (OR).
//   http=200 | path=v1|v2 | path=lo..hi | path!=v | path~regex | path? | path!? | body~regex | body!~regex
def body = prev.getResponseDataAsString()
def json = null
try { json = new JsonSlurper().parseText(body) } catch (ignored) { }
def get = { String k -&gt;
    def cur = json
    for (p in k.split('\\.')) { if (cur instanceof Map) { cur = cur[p] } else { return null } }
    cur
}
def check = { String rule -&gt;
    def m
    if ((m = rule =~ /^http=(\d+)$/)) { return prev.getResponseCode() == m[0][1] ? null : ("HTTP " + String.valueOf(prev.getResponseCode()) + " != " + String.valueOf(m[0][1])) }
    if ((m = rule =~ /^body!~(.+)$/)) { return (body =~ m[0][1]) ? ("body must not match /" + String.valueOf(m[0][1]) + "/") : null }
    if ((m = rule =~ /^body~(.+)$/)) { return (body =~ m[0][1]) ? null : ("body must match /" + String.valueOf(m[0][1]) + "/") }
    if (json == null) { return "response is not JSON" }
    if ((m = rule =~ /^([\w.]+)!\?$/)) { return get(m[0][1]) == null ? null : (String.valueOf(m[0][1]) + " must be absent") }
    if ((m = rule =~ /^([\w.]+)\?$/)) { return get(m[0][1]) != null ? null : (String.valueOf(m[0][1]) + " must be present") }
    if ((m = rule =~ /^([\w.]+)~(.+)$/)) { def v = get(m[0][1]); return (v != null &amp;&amp; (v.toString() =~ m[0][2])) ? null : (String.valueOf(m[0][1]) + "='" + String.valueOf(v) + "' !~ /" + String.valueOf(m[0][2]) + "/") }
    if ((m = rule =~ /^([\w.]+)!=(.*)$/)) { def v = get(m[0][1]); return m[0][2].split('\\|').contains(String.valueOf(v)) ? (String.valueOf(m[0][1]) + "='" + String.valueOf(v) + "' must not be " + String.valueOf(m[0][2])) : null }
    if ((m = rule =~ /^([\w.]+)=(-?\d+)\.\.(-?\d+)$/)) { def v = get(m[0][1]); return (v instanceof Number &amp;&amp; v &gt;= m[0][2].toLong() &amp;&amp; v &lt;= m[0][3].toLong()) ? null : (String.valueOf(m[0][1]) + "='" + String.valueOf(v) + "' not in " + String.valueOf(m[0][2]) + ".." + String.valueOf(m[0][3])) }
    if ((m = rule =~ /^([\w.]+)=(.*)$/)) { def v = get(m[0][1]); return m[0][2].split('\\|').contains(String.valueOf(v)) ? null : (String.valueOf(m[0][1]) + "='" + String.valueOf(v) + "' expected " + String.valueOf(m[0][2])) }
    return ("bad rule: " + String.valueOf(rule))
}
def errs = []
Parameters.split(';').each { raw -&gt;
    def rule = raw.trim()
    if (!rule) { return }
    def alts = rule.split(/ \|\| /).collect { check(it.trim()) }
    if (!alts.contains(null)) { errs &lt;&lt; alts.join(' OR ') }
}
if (errs) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(errs.join(' | '))
}
</stringProp></JSR223Assertion><hashTree/></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S01 - GET config seeker_sms_otp_allowed_phone_prefixes (whitelist đầu số SMS OTP)" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="code" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">code</stringProp><stringProp name="Argument.value">seeker_sms_otp_allowed_phone_prefixes</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${systemHost}</stringProp><stringProp name="HTTPSampler.port">443</stringProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">${systemBase}/fe/configuration/detail</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save vars" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">allowed_prefixes=data.value</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
