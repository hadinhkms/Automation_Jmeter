</stringProp></JSR223Sampler><hashTree/><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[wait] Chờ OTP hiện tại hết hạn" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Sleep until the currently valid OTP (tracked from data.seconds / remaining_seconds) has expired + 3s margin.
long until = (vars.get('otp_valid_until') ?: '0') as long
long ms = until - System.currentTimeMillis() + 3000L
if (ms &gt; 0) { Thread.sleep(ms) }
SampleResult.setResponseData(("waited " + String.valueOf(Math.max(ms, 0L)) + " ms for OTP expiry"), 'UTF-8')
