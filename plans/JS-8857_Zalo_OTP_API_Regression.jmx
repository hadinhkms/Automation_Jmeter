int n = (vars.get('succ_count') ?: '0') as int
def msg = ("daily_done=" + String.valueOf(done) + " successful_sends_in_loop=" + String.valueOf(n) + " error_code=" + String.valueOf(vars.get('daily_limit_error_code')) + " msg=" + String.valueOf(vars.get('daily_limit_msg')))
SampleResult.setResponseData(msg, 'UTF-8')
if (!done) { SampleResult.setSuccessful(false); SampleResult.setResponseMessage('Daily limit (Error #7) was never reached within 6 iterations') }
</stringProp></JSR223Sampler><hashTree/></hashTree></hashTree><GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="[Flow 20] Error contract consistency (dữ liệu đã thu thập)" enabled="true"><stringProp name="TestPlan.comments"></stringProp></GenericController><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="F20-01 Error #8 format [m:ss] đồng nhất Zalo/SMS (channel field không thuộc REQ)" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Error #8 format consistency Zalo vs SMS (REQ: msg countdown [m:ss]; channel field KHÔNG được REQ định nghĩa nên không check).
def errs = []
def z = vars.get('msg8_zalo') ?: ''
def s = vars.get('msg8_sms') ?: ''
// Chuẩn hóa phần countdown để so khung format giữa 2 kênh (đuôi 's' chấp nhận nhưng phải đồng nhất).
def norm = { String m -&gt; m.replaceAll(/\d+:\d{2}/, '[m:ss]') }
if (z &amp;&amp; s &amp;&amp; norm(z) != norm(s)) { errs &lt;&lt; ("Error #8 format KHONG dong nhat Zalo/SMS: zalo='" + z + "' sms='" + s + "'") }
if (z &amp;&amp; !(z ==~ /.*sau \d+:\d{2}s?$/)) { errs &lt;&lt; ("Zalo Error #8 thieu countdown [m:ss]: '" + z + "'") }
if (s &amp;&amp; !(s ==~ /.*sau \d+:\d{2}s?$/)) { errs &lt;&lt; ("SMS Error #8 thieu countdown [m:ss]: '" + s + "'") }
SampleResult.setResponseData(("zalo#8='" + z + "' | sms#8='" + s + "'"), 'UTF-8')
if (errs) { SampleResult.setSuccessful(false); SampleResult.setResponseMessage(errs.join(' | ')) }
