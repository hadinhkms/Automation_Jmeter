ts.toList().eachWithIndex { ch, k -&gt;
    int d = ch.toInteger()
    sb.append(k % 2 == 1 ? ch : (d == 0 ? A[62] : A[d + r]))
}
def tail = md5(String.valueOf(r))
while (sb.length() &lt; 64 - tail.length()) { sb.append(A[1 + rnd.nextInt(62)]) }
