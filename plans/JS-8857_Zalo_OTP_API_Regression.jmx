// Reproduces seeker FE nonce (Xa): 13-char encoded timestamp + filler + md5(r). Server checks freshness +-180s.
def md5 = { String s -&gt; MessageDigest.getInstance('MD5').digest(s.getBytes('UTF-8')).encodeHex().toString() }
def A = '_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
def rnd = new Random()
int r = rnd.nextInt(41) + 1  // server Utils::decodeOTPNonce scans ratio in [1, 42) -&gt; max 41 (otp-tools/lib/nonce.js)
def ts = String.valueOf(System.currentTimeMillis())
def sb = new StringBuilder()
ts.toList().eachWithIndex { ch, k -&gt;
    int d = ch.toInteger()
    sb.append(k % 2 == 1 ? ch : (d == 0 ? A[62] : A[d + r]))
}
def tail = md5(String.valueOf(r))
while (sb.length() &lt; 64 - tail.length()) { sb.append(A[1 + rnd.nextInt(62)]) }
vars.put('nonce', sb.toString() + tail)
</stringProp></JSR223PreProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Compute otp_token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
import java.security.MessageDigest
// token sent to request-otp = md5("&lt;t&gt;:&lt;s&gt;:&lt;nonce&gt;") (FE requestOTP)
def d = new JsonSlurper().parseText(prev.getResponseDataAsString())?.data
if (d?.t &amp;&amp; d?.s) {
    def raw = (String.valueOf(d.t) + ":" + String.valueOf(d.s) + ":" + String.valueOf(vars.get('nonce'))).toString()
    vars.put('otp_token', MessageDigest.getInstance('MD5').digest(raw.getBytes('UTF-8')).encodeHex().toString())
} else {
    vars.put('otp_token', 'ANTIBOT_TOKEN_MISSING')
}
