</stringProp></JSR223Assertion><hashTree/></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="F14-01 Gửi OTP (${loop_channel}) lượt #${loop_i} -&gt; thành công hoặc Error #7 khi đã đủ 5 lượt/ngày" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"phone":"${phone}","platform":"web","device_id":"${device_id}","nonce":"${nonce}","token":"${otp_token}"}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${seekerHost}</stringProp><stringProp name="HTTPSampler.port">443</stringProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">${seekerBase}${loop_req_path}</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save vars" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
// Parameters: "var=json.path,var2=json.path". Also tracks OTP validity window for the [wait] steps.
def json = null
try { json = new JsonSlurper().parseText(prev.getResponseDataAsString()) } catch (ignored) { return }
def get = { String k -&gt;
    def cur = json
    for (p in k.split('\\.')) { if (cur instanceof Map) { cur = cur[p] } else { return null } }
    cur
}
Parameters.split(',').each { pair -&gt;
    if (!pair.contains('=')) { return }
    def (k, path) = pair.split('=', 2)
    def v = get(path.trim())
    vars.put(k.trim(), v == null ? '' : v.toString())
}
def secs = get('data.seconds') ?: get('data.remaining_seconds')
if (secs != null) {
    long until = System.currentTimeMillis() + (secs as long) * 1000L
    long prevUntil = (vars.get('otp_valid_until') ?: '0') as long
    vars.put('otp_valid_until', String.valueOf(Math.max(until, prevUntil)))
}
</stringProp></JSR223PostProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Classify result" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
def j = null
try { j = new JsonSlurper().parseText(prev.getResponseDataAsString()) } catch (ignored) { }
vars.put('loop_success', 'false')
if (j?.data?.status == true) {
    vars.put('loop_success', 'true')
    vars.put('succ_count', String.valueOf(((vars.get('succ_count') ?: '0') as int) + 1))
    vars.put('cur_req', j.data.request_id?.toString() ?: '')
    vars.put('cur_verify_path', vars.get('loop_verify_path'))
} else if ((j?.msg ?: '').toString().contains('5 lần/ngày') || (j?.data?.error_code ?: '').toString().contains('LIMIT')) {
    vars.put('daily_done', 'true')
    vars.put('daily_limit_error_code', (j?.data?.error_code ?: '').toString())
    vars.put('daily_limit_msg', (j?.msg ?: '').toString())
}
