int i = ((vars.get('loop_i') ?: '0') as int) + 1
vars.put('loop_i', String.valueOf(i))
boolean zalo = i % 2 == 1
vars.put('loop_channel', zalo ? 'zalo' : 'sms')
vars.put('loop_req_path', zalo ? '/fe/api/v1/guest/auth/zalo/request-otp' : '/fe/api/v1/guest/auth/request-otp')
vars.put('loop_verify_path', zalo ? '/fe/api/v1/guest/auth/zalo/verify-otp-and-list-accounts' : '/fe/api/v1/guest/auth/list-account-by-phone')
