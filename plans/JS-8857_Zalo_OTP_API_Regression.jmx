// Parameters: "var=json.path,var2=json.path". Also tracks OTP validity window for the [wait] steps.
def json = null
try { json = new JsonSlurper().parseText(prev.getResponseDataAsString()) } catch (ignored) { return }
def get = { String k -&gt;
    def cur = json
    for (p in k.split('\\.')) { if (cur instanceof Map) { cur = cur[p] } else { return null } }
    cur
}
Parameters.split(',').each { pair -&gt;
    if (!pair.contains('=')) { return }
    def (k, path) = pair.split('=', 2)
    def v = get(path.trim())
    vars.put(k.trim(), v == null ? '' : v.toString())
}
def secs = get('data.seconds') ?: get('data.remaining_seconds')
if (secs != null) {
    long until = System.currentTimeMillis() + (secs as long) * 1000L
    long prevUntil = (vars.get('otp_valid_until') ?: '0') as long
    vars.put('otp_valid_until', String.valueOf(Math.max(until, prevUntil)))
}
</stringProp></JSR223PostProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep nonce/token for replay test" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">vars.put('used_nonce', vars.get('nonce')); vars.put('used_token', vars.get('otp_token'))</stringProp></JSR223PostProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">code=200;data.status=true;data.phone=${phone};data.request_id?;data.seconds=120;data.expired_at?;body!~"(otp|otp_code|code_otp)"\\s*:</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
