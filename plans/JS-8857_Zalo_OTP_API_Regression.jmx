Parameters.split(',').each { pair -&gt;
    if (!pair.contains('=')) { return }
    def (k, path) = pair.split('=', 2)
    def v = get(path.trim())
    vars.put(k.trim(), v == null ? '' : v.toString())
}
def secs = get('data.seconds') ?: get('data.remaining_seconds')
if (secs != null) {
    long until = System.currentTimeMillis() + (secs as long) * 1000L
    long prevUntil = (vars.get('otp_valid_until') ?: '0') as long
    vars.put('otp_valid_until', String.valueOf(Math.max(until, prevUntil)))
}
