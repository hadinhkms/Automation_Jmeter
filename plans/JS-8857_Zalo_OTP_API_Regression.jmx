// token sent to request-otp = md5("&lt;t&gt;:&lt;s&gt;:&lt;nonce&gt;") (FE requestOTP)
def d = new JsonSlurper().parseText(prev.getResponseDataAsString())?.data
if (d?.t &amp;&amp; d?.s) {
    def raw = (String.valueOf(d.t) + ":" + String.valueOf(d.s) + ":" + String.valueOf(vars.get('nonce'))).toString()
    vars.put('otp_token', MessageDigest.getInstance('MD5').digest(raw.getBytes('UTF-8')).encodeHex().toString())
} else {
    vars.put('otp_token', 'ANTIBOT_TOKEN_MISSING')
}
