    if ((m = rule =~ /^([\w.]+)\?$/)) { return get(m[0][1]) != null ? null : (String.valueOf(m[0][1]) + " must be present") }
    if ((m = rule =~ /^([\w.]+)~(.+)$/)) { def v = get(m[0][1]); return (v != null &amp;&amp; (v.toString() =~ m[0][2])) ? null : (String.valueOf(m[0][1]) + "='" + String.valueOf(v) + "' !~ /" + String.valueOf(m[0][2]) + "/") }
