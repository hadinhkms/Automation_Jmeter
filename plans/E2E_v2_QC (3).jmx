          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper

// Lấy response body từ JMeter và parse JSON
def responseBody = prev.getResponseDataAsString()
def jsonData = new JsonSlurper().parseText(responseBody)

// Lấy mảng "data" từ JSON response
def responseData = jsonData.data instanceof List ? jsonData.data : [jsonData.data]

// Hàm tìm item theo service_code
def findServiceItem = { serviceCode -&gt;
    responseData.find { it.service_code == serviceCode }
}

// Các service cần tìm
def freemiumItem = findServiceItem("vl24h.jobbox.freemium")
def tinCoBanItem = findServiceItem("vl24h.jobbox.basic")
def trangchuTuyengapItem = findServiceItem("vl24h.jobbox.trangchu_tuyengap")
def uuTienTrangNganhItem = findServiceItem("vl24h.jobbox.uutien_trangnganh")
def urgentService = findServiceItem("vl24h.hiring.urgent")

// Lưu các service vào biến JMeter (nếu tìm thấy)
if (freemiumItem) vars.put("freemiumItem", groovy.json.JsonOutput.toJson(freemiumItem))
if (tinCoBanItem) vars.put("tinCoBanItem", groovy.json.JsonOutput.toJson(tinCoBanItem))
if (trangchuTuyengapItem) vars.put("trangchuTuyengapItem", groovy.json.JsonOutput.toJson(trangchuTuyengapItem))
if (uuTienTrangNganhItem) vars.put("uuTienTrangNganhItem", groovy.json.JsonOutput.toJson(uuTienTrangNganhItem))
if (urgentService) vars.put("urgentService", groovy.json.JsonOutput.toJson(urgentService))

// Tìm refreshDayService
def refreshDayService = null
responseData.each { item -&gt;
    if (item.service_code == "vl24h.refresh_day") {
        refreshDayService = item
    } else if (item.sales_order_items_child) {
        item.sales_order_items_child.each { childItem -&gt;
            if (childItem.service_code == "vl24h.refresh_day" &amp;&amp; refreshDayService == null) {
                refreshDayService = childItem
            }
        }
    }
}
if (refreshDayService) vars.put("refreshDayService", groovy.json.JsonOutput.toJson(refreshDayService))

// Tìm refreshHourService
def refreshHourService = null
responseData.each { item -&gt;
    if (item.service_code == "vl24h.refresh_hour") {
        refreshHourService = item
    } else if (item.sales_order_items_child) {
        item.sales_order_items_child.each { childItem -&gt;
            if (childItem.service_code == "vl24h.refresh_hour" &amp;&amp; refreshHourService == null) {
                refreshHourService = childItem
            }
        }
    }
}
if (refreshHourService) vars.put("refreshHourService", groovy.json.JsonOutput.toJson(refreshHourService))

// Debug log (tùy chọn)
log.info("Freemium Item: " + freemiumItem)
log.info("Tin cơ bản Item: " + tinCoBanItem)
log.info("Trang chủ - Tuyển gấp Item: " + trangchuTuyengapItem)
log.info("Ưu tiên trang ngành: " + uuTienTrangNganhItem)
log.info("Urgent Service: " + urgentService)
log.info("Refresh Day Service: " + refreshDayService)
log.info("Refresh Hour Service: " + refreshHourService)
</stringProp></JSR223PostProcessor>
