          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Import thư viện cần thiết
import groovy.json.JsonSlurper
import org.apache.commons.text.StringEscapeUtils

// Lấy nội dung từ response
String htmlString = prev.getResponseDataAsString()

// Sử dụng Regular Expression để tìm và trích xuất nội dung JSON từ thẻ &lt;script&gt;
def regex = /&lt;script id="__NEXT_DATA__" type="application\/json"&gt;([^&lt;]+)&lt;\/script&gt;/
def matcher = (htmlString =~ regex)

// Kiểm tra nếu tìm thấy JSON
if (matcher &amp;&amp; matcher[0] &amp;&amp; matcher[0][1]) {
    try {
        // Parse chuỗi JSON từ thẻ &lt;script&gt;
        def jsonData = new JsonSlurper().parseText(matcher[0][1])

        // Truy cập vào các trường mong muốn
        def jobData = jsonData?.props?.initialState?.api?.jobDetailHiddenContact?.data
        def description = jobData?.description?.toString() ?: "Không có mô tả"
        def otherRequirement = jobData?.other_requirement?.toString() ?: "Không có yêu cầu khác"
        def benefit = jobData?.benefit?.toString() ?: "Không có lợi ích"
        def contact_address = jobData?.contact_address?.toString() ?: "Không có địa chỉ"

        // Lưu các giá trị vào biến JMeter (nếu có)
        vars.put("description_job", StringEscapeUtils.escapeJson(description))
        vars.put("other_requirement_job", StringEscapeUtils.escapeJson(otherRequirement))
        vars.put("benefit_job", StringEscapeUtils.escapeJson(benefit))
        vars.put("contact_address", StringEscapeUtils.escapeJson(contact_address))

        // Ghi log kết quả
//        log.info('Description: ${description}')
//        log.info('Other Requirement: ${otherRequirement}')
//        log.info('Benefit: ${benefit}')
//        log.info('Contact Address: ${contact_address}')

    } catch (Exception e) {
        log.error('Lỗi khi parse JSON: ${e.message}', e)
    }
} else {
    log.warn("Không tìm thấy nội dung JSON trong thẻ &lt;script&gt;")
}
</stringProp></JSR223PostProcessor>
