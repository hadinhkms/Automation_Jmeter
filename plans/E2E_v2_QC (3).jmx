          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - description có chữ Urgent" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Import thư viện cần thiết
import groovy.json.JsonSlurper
import org.apache.commons.text.StringEscapeUtils

// Lấy nội dung từ response
String htmlString = prev.getResponseDataAsString()

// Regex để tìm JSON trong thẻ &lt;script&gt;
def regex = /&lt;script id="__NEXT_DATA__" type="application\/json"&gt;([^&lt;]+)&lt;\/script&gt;/
def matcher = (htmlString =~ regex)

// Kiểm tra nếu tìm thấy JSON
if (matcher &amp;&amp; matcher[0] &amp;&amp; matcher[0][1]) {
    try {
        // Parse chuỗi JSON từ thẻ &lt;script&gt;
        def jsonData = new JsonSlurper().parseText(matcher[0][1])

        // Truy cập vào các trường mong muốn
        def jobData = jsonData?.props?.initialState?.api?.jobDetailHiddenContact?.data
        def description = jobData?.description?.toString() ?: "Không có mô tả"
        def otherRequirement = jobData?.other_requirement?.toString() ?: "Không có yêu cầu khác"
        def benefit = jobData?.benefit?.toString() ?: "Không có lợi ích"
        def contact_address = jobData?.contact_address?.toString() ?: "Không có địa chỉ"

        // --- Xử lý urgentNote ---
        def urgentNote = "" 
        def flagUrgentJob = vars.get("flagUrgentJob") ?: "1"  // lấy biến JMeter
        if (flagUrgentJob.toInteger() == 1) {
            urgentNote = "\nurgent, tuyển gấp, cần tuyển gấp"
        }

        // --- Thêm copyJob ---
//        def job_id_refer = vars.get("job_id_refer") ?: "N/A"
//        def copyJob = "\nCopy từ job: ${job_id_refer}"
		 def copyJob = ""

        // --- Lưu giá trị vào biến JMeter ---
        vars.put("description_job", StringEscapeUtils.escapeJson(description + urgentNote + copyJob))
        vars.put("other_requirement_job", StringEscapeUtils.escapeJson(otherRequirement + urgentNote))
        vars.put("benefit_job", StringEscapeUtils.escapeJson(benefit + urgentNote))
        vars.put("contact_address", StringEscapeUtils.escapeJson(contact_address)) // giữ nguyên

        // Debug log (nếu cần)
        // log.info("Description: " + vars.get("description_job"))
        // log.info("Other Requirement: " + vars.get("other_requirement_job"))
        // log.info("Benefit: " + vars.get("benefit_job"))
        // log.info("Contact Address: " + vars.get("contact_address"))

    } catch (Exception e) {
        log.error("Lỗi khi parse JSON: " + e.message, e)
    }
} else {
    log.warn("Không tìm thấy nội dung JSON trong thẻ &lt;script&gt;")
}
</stringProp></JSR223PostProcessor>
