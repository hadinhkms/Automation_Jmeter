          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Tạo danh sách các effect codes
def effectCodes = ['vl24h.hot', 'vl24h.red', 'vl24h.urgent', 'vl24h.outline', 'vl24h.2hu', 'vl24h.3hu', 'vl24h.4hu']

// Chọn ngẫu nhiên một effect code
def randomEffectCode = effectCodes[Math.floor(Math.random() * effectCodes.size())]

// Lưu giá trị vào biến JMeter
vars.put("effect_code", randomEffectCode)
</stringProp></JSR223PreProcessor>
