          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Parse JSON response
import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

// Kiểm tra nếu có dữ liệu
if (json.data &amp;&amp; json.data.size() &gt; 0) {
    // Lấy ngẫu nhiên một phần tử trong danh sách data
    def randomData = json.data[new Random().nextInt(json.data.size())]

    // Lấy giá trị của id và code
    def randomId = randomData.id
    def randomCode = randomData.code

    // Lưu vào biến JMeter
    vars.put("customer_care_member_id", randomId)
    vars.put("customer_care_member_code", randomCode)
    
    log.info("revenue_by_staff_id: " + randomId)
    log.info("revenue_by_staff_code: " + randomCode)
}
</stringProp></JSR223PostProcessor>
