      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group - Create Jobs" enabled="true"><stringProp name="comments"/><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp><boolProp name="ThreadGroup.delayedStart">false</boolProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration">0</stringProp><stringProp name="ThreadGroup.delay">0</stringProp></ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler - delete job expired in file csv" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">import java.text.SimpleDateFormat

// ========================
// Cấu hình
// ========================
def csvFile = "${folderdata}/csvfile_${vars.get('envi')}.csv"

// Định dạng ngày
def dateFormat = new SimpleDateFormat("yyyyMMdd")
dateFormat.setLenient(false) // ngày phải hợp lệ
def currentDate = dateFormat.format(new Date())

// Hàm kiểm tra ngày
def isValidDate = { dateStr -&gt;
    try {
        dateFormat.parse(dateStr)
        return true
    } catch (Exception e) {
        return false
    }
}

// ========================
// Xử lý CSV
// ========================
def lines = new File(csvFile).readLines()
def filteredLines = []

lines.eachWithIndex { line, idx -&gt;
    def parts = line.split(",")
    if (parts.size() == 2) {
        def dateStr = parts[1].trim()
        if (isValidDate(dateStr) &amp;&amp; dateStr &gt;= currentDate) {
            filteredLines &lt;&lt; line
        } else {
            log.info("❌ Bỏ dòng ${idx+1}: '${line}' (ngày không hợp lệ hoặc nhỏ hơn hiện tại)")
        }
    } else {
        log.info("❌ Bỏ dòng ${idx+1}: '${line}' (không đủ 2 cột)")
    }
}

// ========================
// Ghi đè file
// ========================
new File(csvFile).text = filteredLines.join("\n") + "\n"

log.info("✅ File updated successfully: ${csvFile}")
log.info("✅ Số dòng hợp lệ còn lại: ${filteredLines.size()}")
</stringProp></JSR223Sampler>
        <hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler - random province" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">import org.apache.jmeter.services.FileServer
import java.nio.file.Files
import java.nio.file.Paths
import java.util.concurrent.ThreadLocalRandom

// Đường dẫn tới file CSV
def csvPath = FileServer.getFileServer().getBaseDir() + "/data/provinces.csv"

// Biến toàn cục để cache dữ liệu (chỉ đọc file 1 lần)
if (props.get("provinceData") == null) {
    def lines = Files.readAllLines(Paths.get(csvPath))
    // Nếu có header thì bỏ dòng đầu tiên
    if (lines[0].toLowerCase().contains("province")) {
        lines.remove(0)
    }
    def dataList = []
    lines.each { line -&gt;
        def parts = line.split(",")
        dataList &lt;&lt; [province_id: parts[0].trim(), displayed_area: parts[1].trim()]
    }
    props.put("provinceData", dataList)
}

// Lấy danh sách từ props
def provinces = props.get("provinceData")
def randomIndex = ThreadLocalRandom.current().nextInt(provinces.size())
def record = provinces[randomIndex]

// Gán giá trị vào biến JMeter
vars.put("province_id", record.province_id)
vars.put("displayed_area", record.displayed_area)
</stringProp></JSR223Sampler>
