          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper

// Lấy response body dưới dạng chuỗi
def responseBody = prev.getResponseDataAsString()

// Parse response thành JSON object
def jsonSlurper = new JsonSlurper()
def jsonData = jsonSlurper.parseText(responseBody)

// Lấy random một đối tượng chứa service_type và service_code
def randomServiceData = jsonData.data[new Random().nextInt(jsonData.data.size())]

// Lưu giá trị random "service_type" và "service_code" vào các biến của JMeter
vars.put("service_type", randomServiceData.service_type as String)
vars.put("service_code", randomServiceData.service_code as String)

// Ghi log để kiểm tra
log.info("Random Service Type: " + randomServiceData.service_type)
log.info("Random Service Code: " + randomServiceData.service_code)
</stringProp></JSR223PostProcessor>
