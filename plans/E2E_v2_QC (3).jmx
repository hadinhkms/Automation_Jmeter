        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">import java.nio.file.Files
import java.nio.file.Paths
import java.nio.file.StandardOpenOption
import java.text.SimpleDateFormat
import java.util.Date

def folderData = vars.get("folderdata") ?: "D:/Project_Jmeter/data"
def envi = vars.get("envi") ?: "qc"
def csvFilePath = "${folderData}/csvfile_${envi}.csv"
def writeQueue = props.get("csvWriteQueue") as List

if (writeQueue == null || writeQueue.isEmpty()) {
    log.info("Không có job mới để ghi CSV")
    return
}

synchronized(this) {
    writeQueue.each { entry -&gt;
        def expired = entry.expired
        def formatted = "N/A"
        if (expired?.isLong()) {
            formatted = new SimpleDateFormat("yyyyMMdd")
                .format(new Date(expired.toLong() * 1000))
        }
        def line = "${entry.job_id},${formatted}"
        Files.write(Paths.get(csvFilePath), (line + System.lineSeparator()).getBytes(),
            StandardOpenOption.CREATE, StandardOpenOption.APPEND)
        log.info("Đã ghi CSV: ${line}")
    }
    writeQueue.clear()
}
