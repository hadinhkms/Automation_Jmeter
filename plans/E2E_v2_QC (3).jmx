        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Lấy giá trị từ các biến JMeter
String logoPath = vars.get("pathFileLogo"); // Logo file path
String logoURL = vars.get("urlFileLogo");  // Full logo URL

// Kiểm tra và gán giá trị cho logo và logo_url
if (logoPath == null || logoPath.isEmpty()) {
    vars.put("logoValue", "null"); // Nếu không có giá trị, đặt logo là null
} else {
    vars.put("logoValue", "\"" + logoPath + "\""); // Nếu có giá trị, thêm dấu nháy
}

if (logoURL == null || logoURL.isEmpty()) {
    vars.put("logoUrlValue", "null"); // Nếu không có giá trị, đặt logo_url là null
} else {
    vars.put("logoUrlValue", "\"" + logoURL + "\""); // Nếu có giá trị, thêm dấu nháy
}
</stringProp></JSR223PreProcessor>
