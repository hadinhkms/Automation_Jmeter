          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Tạo danh sách các giá trị effect_code
def effectCodes = ['vl24h.refresh_day', 'vl24h.refresh_hour']

// Chọn một giá trị ngẫu nhiên từ danh sách
def randomEffectCode = effectCodes[new Random().nextInt(effectCodes.size())]

// Lưu giá trị random vào biến của JMeter
vars.put("effect_code", randomEffectCode)

// Ghi log để kiểm tra
log.info("Random Effect Code (PreProcessor): " + randomEffectCode)
</stringProp></JSR223PreProcessor>
          <hashTree>
          </hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper

// Lấy response body dưới dạng chuỗi
def responseBody = prev.getResponseDataAsString()

// Parse response thành JSON object
def jsonSlurper = new JsonSlurper()
def jsonData = jsonSlurper.parseText(responseBody)

// Lấy thông tin "sku_code" từ response
def skuCode = jsonData.data?.sku_code

// Lưu giá trị "sku_code" vào biến của JMeter với tên "sku_code_service"
if (skuCode) {
    vars.put("sku_code_service", skuCode as String)
    log.info("SKU Code: " + skuCode)
} else {
    log.warn("SKU Code not found in the response")
}
</stringProp></JSR223PostProcessor>
