            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Lấy giá trị của total_pages từ response
def response = prev.getResponseDataAsString()
def jsonResponse = new groovy.json.JsonSlurper().parseText(response)
def totalPages = jsonResponse.data.total_pages

// Kiểm tra nếu total_pages lớn hơn 50 thì giới hạn số ngẫu nhiên từ 1 đến 50
if (totalPages &gt; 50) {
    totalPages = 50
}

// Tạo số ngẫu nhiên từ 1 đến totalPages
def randomPage = (Math.random() * totalPages).toInteger() + 1

// Ghi thông tin vào log
log.info("Random Page: " + randomPage)

// Lưu giá trị randomPage vào biến môi trường
vars.put("randomPage", randomPage.toString())
</stringProp></JSR223PostProcessor>
