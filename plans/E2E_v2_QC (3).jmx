          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Danh sách mã vùng Việt Nam cho di động
def vietnamMobilePrefixes = [
    "032", "033", "034", "035", "036", "037", "038", "039", // Viettel
    "070", "079", "077", "076", "078",                     // Mobifone
    "081", "082", "083", "084", "085", "086", "088",       // Vinaphone
    "056", "058",                                          // Vietnamobile
    "059"                                                 // Gmobile
]

// Chọn ngẫu nhiên một mã vùng
def randomPrefix = vietnamMobilePrefixes[new Random().nextInt(vietnamMobilePrefixes.size())]

// Tạo số điện thoại với 7 chữ số ngẫu nhiên phía sau
def randomSuffix = String.format("%07d", new Random().nextInt(10000000))

// Ghép mã vùng và phần ngẫu nhiên để tạo số điện thoại đầy đủ
def vietnamPhoneNumber = randomPrefix + randomSuffix

// Lưu số điện thoại vào biến JMeter
vars.put("vietnam_phone", vietnamPhoneNumber)

// In ra log để kiểm tra (tùy chọn)
log.info("Generated Vietnam Phone Number: " + vietnamPhoneNumber)


// Kiểm tra biến is_cv_optional
def isCvOptional = vars.get("is_cv_optional")

if (isCvOptional == "1") {
    // Nếu có biến title, thêm " CV" vào cuối
    def currentTitle = vars.get("title") ?: ""
    def updatedTitle = currentTitle + " No-CV"
    vars.put("title", updatedTitle)
    log.info("Updated title with CV: " + updatedTitle)
} else {
    log.info("No CV required, title unchanged.")
}
</stringProp></JSR223PreProcessor>
