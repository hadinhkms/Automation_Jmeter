          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Lấy giá trị biến từ JMeter
def phone = vars.get("RE_contact_info.contact_phone")

// Kiểm tra nếu biến rỗng, null, hoặc có độ dài lớn hơn 10 ký tự
if (phone == null || phone.trim().isEmpty() || phone.length() &gt; 10) {
    // Nếu không hợp lệ, tạo số điện thoại Việt Nam ngẫu nhiên
    def areaCode = ["091", "092", "093", "094", "095", "096", "097", "098", "099"]
    def randomArea = areaCode[new Random().nextInt(areaCode.size())]
    def number = (1000000 + new Random().nextInt(9000000))  // Tạo số ngẫu nhiên
    phone = randomArea + number
} else {
    // Nếu hợp lệ, loại bỏ khoảng trắng
    phone = phone.replaceAll("\\s+", "")
}

// Lưu giá trị đã xử lý lại vào biến
vars.put("RE_contact_info.contact_phone", phone)
</stringProp></JSR223PreProcessor>
