            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - check job_id refer csv" enabled="true"><stringProp name="comments"/><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.util.HashSet
import java.util.Collections

// --- Load set toàn cục ---
def globalExistingJobIds = props.get("globalExistingJobIds") as HashSet
if (globalExistingJobIds == null) {
    globalExistingJobIds = new HashSet&lt;String&gt;()
    props.put("globalExistingJobIds", globalExistingJobIds)
}

// --- Parse response ---
def responseBody = prev.getResponseDataAsString()
def jsonResponse = new JsonSlurper().parseText(responseBody)

// --- Lọc job mới ---
def validItems = jsonResponse?.data?.items?.findAll {
    def jid = it.id?.toString()?.trim()
    jid &amp;&amp; !globalExistingJobIds.contains(jid)
} ?: []

if (!validItems) {
    vars.put("CONTINUE_LOOP", "true")
    return
}

def selectedItem = validItems[new Random().nextInt(validItems.size())]
def job_id_refer = selectedItem.id?.toString()?.trim()
def expired = selectedItem.resume_apply_expired?.toString()?.trim()

// --- Add ngay vào set ---
if (!globalExistingJobIds.contains(job_id_refer)) {
    globalExistingJobIds.add(job_id_refer)
    props.put("globalExistingJobIds", globalExistingJobIds)

    // --- Queue để ghi CSV sau ---
    def writeQueue = props.get("csvWriteQueue") as List
    if (writeQueue == null) {
        writeQueue = Collections.synchronizedList(new ArrayList())
        props.put("csvWriteQueue", writeQueue)
    }
    writeQueue.add([job_id: job_id_refer, expired: expired])

    // --- Xuất ra vars cho JMeter dùng ngay ---
    vars.put("job_id_refer", job_id_refer)
    vars.put("title", selectedItem.title?.toString()?.trim())
    vars.put("places", selectedItem.places?.toString() ?: "[]")
//    vars.put("required_fields", selectedItem.required_fields?.toString() ?: "[]")
	def requiredFields = selectedItem.required_fields ?: []
	vars.put("required_fields", JsonOutput.toJson(requiredFields))
    vars.put("vacancy_quantity", selectedItem.vacancy_quantity?.toString()?.trim())
    vars.put("salary_min", selectedItem.salary_min?.toString()?.trim())
    vars.put("salary_max", selectedItem.salary_max?.toString()?.trim())
    vars.put("occupation_ids_main", selectedItem.occupation_ids_main?.toString() ?: "[]")
    vars.put("experience_range", selectedItem.experience_range?.toString()?.trim())
    vars.put("resume_apply_expired", expired)
    vars.put("working_method", selectedItem.working_method?.toString()?.trim())
    vars.put("level_requirement", selectedItem.level_requirement?.toString()?.trim())
    vars.put("contact_name", selectedItem.contact_name?.toString()?.trim())
    vars.put("salary_range", selectedItem.salary_range?.toString()?.trim())
    vars.put("is_cv_optional", selectedItem.is_cv_optional?.toString()?.trim())
    vars.put("degree_requirement", selectedItem.degree_requirement?.toString()?.trim())

    log.info("Queued job_id_refer=${job_id_refer}, expired=${expired} để ghi sau")
    vars.put("CONTINUE_LOOP", "false")
} else {
    log.warn("job_id_refer '${job_id_refer}' đã có trong set → bỏ qua")
    vars.put("CONTINUE_LOOP", "true")
}
</stringProp></JSR223PostProcessor>
