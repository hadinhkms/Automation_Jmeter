        <!-- =================== MODULE 4: SECURITY, IDOR & PARAMETER TAMPERING =================== -->
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="[Module 4] Security, IDOR &amp; Parameter Tampering" enabled="true"/>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TC012 - POST [Security] Kiểm tra xử lý mã độc XSS trong từ khóa (Chặn hoặc Sanitize)" enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
    &quot;search_context&quot;: {&#xd;
        &quot;q&quot;: &quot;&lt;script&gt;alert(&apos;XSS_TEST&apos;)&lt;/script&gt;&quot;,&#xd;
        &quot;province_ids&quot;: [&quot;119&quot;]&#xd;
    },&#xd;
    &quot;frequency&quot;: 2,&#xd;
    &quot;is_email_enable&quot;: 1,&#xd;
    &quot;is_app_enable&quot;: 1&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${host}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">${basePath}/save</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor - temp_xss_id" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">temp_xss_id</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.id</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">0</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion - Kiểm tra XSS được chặn (Code != 200) hoặc đã qua xử lý sanitize chuỗi" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def raw = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(raw)

// Nhánh 1: Backend chủ động chặn (Code 422 hoặc mã lỗi khác 200)
if (json.code != 200) {
    log.info(&apos;[XSS Test] PASS: Backend chặn payload XSS với mã: &apos; + json.code)
    AssertionResult.setFailure(false)
} else {
    // Nhánh 2: Backend cho lưu (Code 200) -> Chuỗi bắt buộc phải được xử lý (sanitized/escaped/stripped)
    def savedQ = json.data?.search_context?.q ?: &apos;&apos;
    if (savedQ.toLowerCase().contains(&apos;&lt;script&gt;&apos;) || savedQ.toLowerCase().contains(&apos;&lt;/script&gt;&apos;)) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;[XSS VULNERABILITY]: Hệ thống cho phép lưu nguyên bản chuỗi script độc hại chưa qua làm sạch: &apos; + savedQ)
    } else {
        log.info(&apos;[XSS Test] PASS: Hệ thống đã làm sạch/escape chuỗi XSS: &apos; + savedQ)
        AssertionResult.setFailure(false)
    }
}
</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
