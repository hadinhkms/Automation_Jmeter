vars.put('regEmail', 'hadtv.nlsv.test+auto_' + sfx + '@gmail.com')
vars.put('regPassword', 'Qa@' + rnd.nextInt(10) + (1..12).collect { chars[rnd.nextInt(chars.length())] }.join())
vars.put('regMobile', '09' + (1..8).collect { rnd.nextInt(10) }.join())
