"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></SetupThreadGroup><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers (biến authName/authVal/branchName/ctype)" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">${authName}</stringProp><stringProp name="Header.value">${authVal}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">${branchName}</stringProp><stringProp name="Header.value">${branchVal}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">${ctype}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">x-lang</stringProp><stringProp name="Header.value">vi</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Mặc định: token A, x-branch, Content-Type (nạp props js8826_*)" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">['token','seekerId','tokenB','seekerIdB','run','fillIds'].each { k -&gt; def v = props.get('js8826_' + k); if (v != null) vars.put(k, v) }
vars.put('authName', 'Authorization'); vars.put('authVal', 'Bearer ' + (vars.get('token') ?: ''))
vars.put('branchName', 'x-branch'); vars.put('branchVal', vars.get('branch')); vars.put('ctype', 'application/json')</stringProp></JSR223PreProcessor><hashTree></hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Ghi nhận danh sách sau mỗi GET list (items/itemsPrev/total)" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def lbl = prev.getSampleLabel()
if (!lbl.contains('GET list') || lbl.contains('[noTrack]')) return

def S = new groovy.json.JsonSlurper()
def findItems = { d -&gt; if (d instanceof List) return d
  if (d instanceof Map) { for (k in ['items','data','list','results','rows','records','job_alerts']) if (d[k] instanceof List) return d[k]
    def v = d.values().find { it instanceof List }; if (v != null) return v }
  [] }
def ids = { l -&gt; (l ?: []).collect { String.valueOf(it?.id) } }
def byId = { l, id -&gt; (l ?: []).find { String.valueOf(it?.id) == String.valueOf(id) } }
def scOf = { it -&gt; def c = it?.search_context
  if (c instanceof String) { try { c = S.parseText(c) } catch (ex) { c = null } }
  c instanceof Map ? c : (it ?: [:]) }
def dec = { s -&gt; if (s == null) return null; def t = String.valueOf(s)
  try { t.contains('%') ? URLDecoder.decode(t.replace('+', '%2B'), 'UTF-8') : t } catch (ex) { t } }
def qOf = { it -&gt; def c = scOf(it); def q = c.containsKey('q') ? c.q : (c.keyword ?: it?.keyword); q == null ? null : dec(q) }
def norm = { v -&gt; v instanceof List ? v.collect { String.valueOf(it) }.sort() : (v == null ? null : String.valueOf(v)) }
def on = { v -&gt; v in [1, '1', true, 'true'] }
def off = { v -&gt; v in [0, '0', false, 'false'] }
def V = { k -&gt; vars.get(k) }
def parseMs = { s -&gt; if (s == null || s == '') return null; def str = String.valueOf(s); Long ms = null
  try { ms = java.time.OffsetDateTime.parse(str).toInstant().toEpochMilli() } catch (ex) {}
  if (ms == null) try { ms = java.time.Instant.parse(str).toEpochMilli() } catch (ex) {}
  if (ms == null) for (f in [&quot;yyyy-MM-dd HH:mm:ss&quot;, &quot;yyyy-MM-dd'T'HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm&quot;]) {
    try { def df = new java.text.SimpleDateFormat(f); df.setTimeZone(TimeZone.getTimeZone('Asia/Ho_Chi_Minh')); df.setLenient(false); ms = df.parse(str).time; break } catch (ex) {} }
  if (ms == null &amp;&amp; str ==~ /\d{10}/) ms = (str as long) * 1000L
  ms }
def items = S.parseText(vars.get('items') ?: '[]')
def itemsPrev = S.parseText(vars.get('itemsPrev') ?: '[]')
def total = (vars.get('total') ?: '-1') as int
def newIds = ids(items) - ids(itemsPrev)
def goneIds = ids(itemsPrev) - ids(items)

def j; try { j = S.parseText(prev.getResponseDataAsString()) } catch (ex) { return }
if (!(j instanceof Map) || String.valueOf(j.code) != '200') return
def d = j.data
def its = findItems(d)
def tot = (d instanceof Map) ? [d.total_items, d.total, d.pagination?.total, d.meta?.total].find { it != null } : null
vars.put('itemsPrev', vars.get('items') ?: '[]')
vars.put('items', groovy.json.JsonOutput.toJson(its))
vars.put('total', String.valueOf(tot == null ? its.size() : tot))
vars.put('totalRaw', tot == null ? '' : String.valueOf(tot))</stringProp></JSR223PostProcessor><hashTree></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[Account] K00 - sinh mã run (gắn vào keyword để không trùng giữa các lần chạy)" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def run = 'R' + new Date().format('MMddHHmmss') + (10 + new Random().nextInt(90))
props.put('js8826_run', run); vars.put('run', run)
SampleResult.setResponseData('run=' + run, 'UTF-8')</stringProp></JSR223Sampler><hashTree></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Không truyền -Jtoken: tự tạo user A" enabled="true"><stringProp name="IfController.condition">${__groovy(!vars.get(&quot;token&quot;))}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[Account] KA0 - sinh email / mobile / password ngẫu nhiên (user A)" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">if (!vars.get('guestToken')) {
  def t = System.getenv('QC_GUEST_TOKEN')
  if (!t) { def base = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() ?: '.'
    def f = [new File('qc-guest-token.local'), new File(base, '../qc-guest-token.local'), new File(base, 'qc-guest-token.local')].find { it.isFile() }
    t = f?.getText('UTF-8')?.trim() }
  if (!t) { log.error('JS-8826: thiếu guest token (-JguestToken / env QC_GUEST_TOKEN / file qc-guest-token.local) -&gt; dừng test')
    SampleResult.setSuccessful(false); SampleResult.setResponseMessage('Thiếu guest token'); SampleResult.setStopTest(true); return }
  vars.put('guestToken', t) }
def rnd = new Random()
def sfx = System.currentTimeMillis().toString() + (100 + rnd.nextInt(900))
def chars = (('a'..'z') + ('A'..'Z') + ('0'..'9')).join()
vars.put('regEmail', 'hadtv.nlsv.test+auto_' + sfx + '@gmail.com')
vars.put('regPassword', 'Qa@' + rnd.nextInt(10) + (1..12).collect { chars[rnd.nextInt(chars.length())] }.join())
vars.put('regMobile', '09' + (1..8).collect { rnd.nextInt(10) }.join())
vars.put('regName', 'QA Auto ' + sfx[-6..-1])
SampleResult.setResponseData('email=' + vars.get('regEmail') + ' mobile=' + vars.get('regMobile'), 'UTF-8')</stringProp></JSR223Sampler><hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[Account] KA1 - POST /register (email) -&gt; token seeker A" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;name&quot;:&quot;${regName}&quot;,&quot;password&quot;:&quot;${regPassword}&quot;,&quot;mobile&quot;:&quot;${regMobile}&quot;,&quot;is_check_policy&quot;:true,&quot;email&quot;:&quot;${regEmail}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.path">${authBase}/register</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Dùng guest token" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">vars.put('authVal', 'Bearer ' + vars.get('guestToken'))</stringProp></JSR223PreProcessor><hashTree></hashTree><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Lấy token + seekerId, chia sẻ qua props" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def j = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def find
find = { o -&gt; if (o instanceof String &amp;&amp; o.startsWith('eyJ') &amp;&amp; o.count('.') == 2) return o
  def vs = o instanceof Map ? o.values() : (o instanceof List ? o : [])
  for (v in vs) { def t = find(v); if (t) return t }; null }
def tok = find(j?.data)
if (!tok) { log.error('JS-8826: đăng ký không trả token -&gt; dừng test'); prev.setStopTest(true); return }
def p = tok.tokenize('.')[1]; p += '=' * ((4 - p.length() % 4) % 4)
def user = new groovy.json.JsonSlurper().parseText(new String(Base64.getUrlDecoder().decode(p), 'UTF-8')).user
props.put('js8826_token', tok); props.put('js8826_seekerId', String.valueOf(user?.id))
vars.put('token', tok); vars.put('seekerId', String.valueOf(user?.id))
log.info('JS-8826: tạo tài khoản seeker ' + user?.id + ' / ' + vars.get('regEmail'))
try { if (new File('runs').isDirectory()) { def dir = new File('runs/accounts'); dir.mkdirs()
    new File(dir, user.id + '.json').write(groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson([seeker_id: user.id,
      email: vars.get('regEmail'), password: vars.get('regPassword'), mobile: vars.get('regMobile'), name: vars.get('regName'),
      branch: vars.get('branch'), token: tok, created_by: 'JS-8826 JMX setUp (user)', created_at: new Date().format('yyyy-MM-dd HH:mm:ss')])), 'UTF-8') }
} catch (ex) { log.warn('Không lưu được file tài khoản: ' + ex.message) }</stringProp></JSR223PostProcessor><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">200</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">import groovy.json.*
def body = prev.getResponseDataAsString() ?: ''
def http = prev.getResponseCode() ?: ''
prev.setSuccessful(true) // đánh giá theo JSON code (BE trả HTTP 200 kèm code trong body)
def msgs = []
def fail = { String m -&gt; msgs &lt;&lt; m; AssertionResult.setFailure(true); AssertionResult.setFailureMessage(msgs.join(' || ') + ' | HTTP ' + http + ' | body=' + body.take(500)) }
def lbl0 = prev.getSampleLabel()
def leaked = body =~ /(?i)(stack ?trace|SQLSTATE|syntax error|\/var\/www|vendor\/|\.php\b|&quot;trace&quot;\s*:|&quot;error&quot;\s*:\s*&quot;#0 )/
if (leaked) { vars.put('leakCount', String.valueOf(((vars.get('leakCount') ?: '0') as int) + 1))
  // API-09/10/11 có expected &quot;không lộ stack trace / SQL&quot;; case khác chỉ đếm, vẫn đánh giá logic
  if (lbl0 =~ /^\[API-(09|10|11)\]/) fail('Lộ thông tin hệ thống (stack trace / SQL / đường dẫn file)') }
if (http.startsWith('5')) { fail('HTTP ' + http + ' (lỗi server)'); return }
def strict = (vars.get('strictSpec') ?: 'true') == 'true'
def ps = (Parameters ?: '*').tokenize('|')
def spec = ((strict || ps.size() &lt; 2) ? ps[0] : ps[1]).trim()
def j = null
try { j = new JsonSlurper().parseText(body) } catch (ex) { }
def code = j instanceof Map ? String.valueOf(j.code) : ('HTTP' + http)
if (spec != '*') {
  def neg = spec.startsWith('!')
  def lst = (neg ? spec.substring(1) : spec).split(',')*.trim()
  if (neg ? lst.contains(code) : !lst.contains(code)) { fail('code=' + code + ', mong đợi ' + spec +(strict &amp;&amp; ps.size() &gt; 1 ? ' [strictSpec]' : '')); return }
}
def data = j instanceof Map ? j.data : null

def S = new groovy.json.JsonSlurper()
def findItems = { d -&gt; if (d instanceof List) return d
  if (d instanceof Map) { for (k in ['items','data','list','results','rows','records','job_alerts']) if (d[k] instanceof List) return d[k]
    def v = d.values().find { it instanceof List }; if (v != null) return v }
  [] }
