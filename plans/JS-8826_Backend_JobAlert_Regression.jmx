def byId = { l, id -&gt; (l ?: []).find { String.valueOf(it?.id) == String.valueOf(id) } }
def scOf = { it -&gt; def c = it?.search_context
  if (c instanceof String) { try { c = S.parseText(c) } catch (ex) { c = null } }
  c instanceof Map ? c : (it ?: [:]) }
def dec = { s -&gt; if (s == null) return null; def t = String.valueOf(s)
  try { t.contains('%') ? URLDecoder.decode(t.replace('+', '%2B'), 'UTF-8') : t } catch (ex) { t } }
def qOf = { it -&gt; def c = scOf(it); def q = c.containsKey('q') ? c.q : (c.keyword ?: it?.keyword); q == null ? null : dec(q) }
def norm = { v -&gt; v instanceof List ? v.collect { String.valueOf(it) }.sort() : (v == null ? null : String.valueOf(v)) }
def on = { v -&gt; v in [1, '1', true, 'true'] }
def off = { v -&gt; v in [0, '0', false, 'false'] }
def V = { k -&gt; vars.get(k) }
def parseMs = { s -&gt; if (s == null || s == '') return null; def str = String.valueOf(s); Long ms = null
  try { ms = java.time.OffsetDateTime.parse(str).toInstant().toEpochMilli() } catch (ex) {}
  if (ms == null) try { ms = java.time.Instant.parse(str).toEpochMilli() } catch (ex) {}
  if (ms == null) for (f in [&quot;yyyy-MM-dd HH:mm:ss&quot;, &quot;yyyy-MM-dd'T'HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm:ss&quot;, &quot;dd/MM/yyyy HH:mm&quot;]) {
    try { def df = new java.text.SimpleDateFormat(f); df.setTimeZone(TimeZone.getTimeZone('Asia/Ho_Chi_Minh')); df.setLenient(false); ms = df.parse(str).time; break } catch (ex) {} }
  if (ms == null &amp;&amp; str ==~ /\d{10}/) ms = (str as long) * 1000L
  ms }
def items = S.parseText(vars.get('items') ?: '[]')
