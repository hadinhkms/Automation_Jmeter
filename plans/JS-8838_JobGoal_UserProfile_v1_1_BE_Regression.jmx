<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="JS-8838 - Job Goal user-profile v1.1 BE Regression" enabled="true"><stringProp name="TestPlan.comments">JS-8838 Enhance personalized page v1.0 - phần BE JS-9022: POST /api/v1/user-profile version 1.1 (?version=1.1 hoặc header X-API-VERSION: 1.1) bỏ required job_goals.job_title (chỉ maxlength 255); mặc định / 1.0 giữ required. Tag [BE-x] = item tab 1 checklist JS-8838. Mặc định QC api.vl24hv2.qc.sieuviet-team.com/seeker/fe/api/v1. Override: -JapiHost -JseekerBase -Jtoken -JseekerId. Test ghi job_goals (đồng bộ sang title/province_ids/lương của resume) trên tài khoản của token, tự lưu &amp; restore job_goals gốc (Z01, tearDown Z91). -JstrictSpec=false: chấp nhận hành vi hiện tại ở case lệch spec. -JrunIdorProbe=true -JotherSeekerId=...: bật D09-D10, CHỈ dùng tài khoản test dùng 1 lần (lần chạy thử 16/11/2026 làm hồ sơ test trả 1001).</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="apiHost" elementType="Argument"><stringProp name="Argument.name">apiHost</stringProp><stringProp name="Argument.value">${__P(apiHost,api.vl24hv2.qc.sieuviet-team.com)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="seekerBase" elementType="Argument"><stringProp name="Argument.name">seekerBase</stringProp><stringProp name="Argument.value">${__P(seekerBase,/seeker/fe/api/v1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="branch" elementType="Argument"><stringProp name="Argument.name">branch</stringProp><stringProp name="Argument.value">${__P(branch,vl24h.north)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="token" elementType="Argument"><stringProp name="Argument.name">token</stringProp><stringProp name="Argument.value">${__P(token,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="seekerId" elementType="Argument"><stringProp name="Argument.name">seekerId</stringProp><stringProp name="Argument.value">${__P(seekerId,2004490862)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="strictSpec" elementType="Argument"><stringProp name="Argument.name">strictSpec</stringProp><stringProp name="Argument.value">${__P(strictSpec,true)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="runIdorProbe" elementType="Argument"><stringProp name="Argument.name">runIdorProbe</stringProp><stringProp name="Argument.value">${__P(runIdorProbe,false)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="otherSeekerId" elementType="Argument"><stringProp name="Argument.name">otherSeekerId</stringProp><stringProp name="Argument.value">${__P(otherSeekerId,2000000001)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></TestPlan><hashTree><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">${apiHost}</stringProp><stringProp name="HTTPSampler.port">443</stringProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.contentEncoding"