        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 - Parse Sitemap and Store Paths" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"/>
            <stringProp name="filename"/>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def xmlContent = prev.getResponseDataAsString()
def matcher = xmlContent =~ /&lt;loc&gt;https?:\/\/[^\/]+(\/[^&lt;]+)&lt;\/loc&gt;/
def paths = []
while (matcher.find()) {
    paths.add(matcher.group(1).trim())
}

if (!paths.isEmpty()) {
    props.put('SITEMAP_JOB_PATHS', paths)
    props.put('SITEMAP_JOB_PATHS_COUNT', String.valueOf(paths.size()))
    log.info('[SetUp] Extracted ' + paths.size() + ' job paths from sitemap.')
    try {
        def baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
        def csvFile = new File(baseDir + '/../data/sitemap_job_paths.csv')
        csvFile.parentFile.mkdirs()
        csvFile.withWriter('UTF-8') { writer -&gt;
            writer.writeLine('job_path')
            paths.each { p -&gt; writer.writeLine(p) }
        }
        log.info('[SetUp] Successfully synced ' + paths.size() + ' paths to ' + csvFile.getAbsolutePath())
    } catch (Exception e) {
        log.warn('[SetUp] Could not write CSV file: ' + e.getMessage())
    }
} else {
    log.warn('[SetUp] Failed to extract paths from sitemap. Will use fallback path.')
}
</stringProp>
          </JSR223PostProcessor>
          <hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
