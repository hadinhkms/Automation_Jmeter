        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 - Select Random Job Path" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="filename"/>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def paths = props.get('SITEMAP_JOB_PATHS')
if (paths != null &amp;&amp; !paths.isEmpty()) {
    int idx = java.util.concurrent.ThreadLocalRandom.current().nextInt(paths.size())
    vars.put('job_path', paths.get(idx))
} else {
    vars.put('job_path', '/xay-dung/ky-su-giam-sat-cong-trinh-thu-nhap-len-den-25-trieu-thang-thuong-du-an-c31p210000160id200818628.html')
}
</stringProp>
        </JSR223PreProcessor>
